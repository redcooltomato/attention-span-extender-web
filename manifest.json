{
    "manifest_version": 2,
    "name": "Attention span expander (not guaranteed)",
    "version": "0.1",

    "description": "Forces you to solve equations, problems or tasks to open websites of specified list",

    "icons": {
        "48": "icons/icon48.png"
    },

    "permissions": [
        "storage",
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["main.js"]
        }
    ],

    "browser_action": {
        "default_title": "Attention span extender",
        "default_popup": "popup/popup.html"
    }
}