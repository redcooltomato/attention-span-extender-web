{
    "manifest_version": 2,
    "name": "Swoon",
    "version": "1.0",

    "description": "Attempts at fixing your attention span by swooning (turning to black pages) domains of your choosing",

    "icons": {
        "48": "assets/icon48.png"
    },

    "permissions": [
        "storage",
        "tabs",
        "activeTab"
    ],

    "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

    "browser_action": {
        "default_title": "Swoon",
        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["./scripts/main.js"]
        }
    ],

    "web_accessible_resources": [
        "assets/icon48.png"
    ]
}