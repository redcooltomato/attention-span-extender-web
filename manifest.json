{
    "manifest_version": 2,
    "name": "Swoon",
    "version": "0.2",

    "description": "Attempts at fixing your attention span by swooning (blocking) domains of your choosing",

    "icons": {
        "48": "assets/icon48.png"
    },

    "permissions": [
        "storage",
        "tabs",
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["./scripts/main.js"]
        }
    ],

    "browser_action": {
        "default_title": "Attention span extender",
        "default_popup": "popup/popup.html"
    }
}